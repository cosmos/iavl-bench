  ],
  "simulations": [
    {
      "name": "bank-1m",
      "stores": [
        {
          "name": "auth",
          "key_len_mean": 33,
          "key_len_stddev": 3,
          "value_len_mean": 128,
          "value_len_stddev": 2
        },
        {
          "name": "bank",
          "key_len_mean": 56,
          "key_len_stddev": 3,
          "value_len_mean": 16,
          "value_len_stddev": 2
        }
      ],
      "phases": [
        {
          "versions": 100,
          "stores": {
            "auth": {
              "inserts": 10000
            },
            "bank": {
              "inserts": 10000
            }
          }
        },
        {
          "versions": 20000,
          "stores": {
            "auth": {
              "gets": 20000,
              "updates": 10000
            },
            "bank": {
              "gets": 30000,
              "updates": 20000
            }
          }
        }
      ],
      "concurrent_readers": 32
    }
  ]
}
