{
  "configs": [
    {
      "name": "iavlx-long",
      "runner": "bench-iavlx",
      "options": {
        "changeset_rollover_size": 1048576 // 1 MiB
      },
      "pruning": {
        "KeepRecent": 3,
        "Interval": 100
      }
    }
