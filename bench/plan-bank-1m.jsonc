{
  "configs": [
    {
      "name": "iavlx2",
      "runner": "bench-iavlx2",
      "options": {
        "fsync_wal": true,
        "evict_depth": 28,
        "checkpoint_interval": 500
      }
    },
    {
      "name": "memiavl",
      "runner": "bench-memiavl",
      "options": {
        "snapshot_interval": 1000,
        "snapshot_keep_recent": 1
      }
    },
    {
      "name": "iavl-v1-memdb",
      "runner": "bench-iavl-v1",
      "options": {"cache_size": 2000000, "mem":  true}
    },
    {
      "name": "iavl-v1",
      "runner": "bench-iavl-v1",
      "options": {"cache_size": 2000000}
    }
  ],
  "simulations": [
    {
      "name": "1m",
      "stores": [
        {
          "name": "bank",
          "key_len_mean": 56,
          "key_len_stddev": 3,
          "value_len_mean": 16,
          "value_len_stddev": 2
        }
      ],
      "phases": [
        {
          "versions": 100,
          "stores": {
            "bank": {
              "inserts": 10000
            }
          }
        },
        {
          "versions": 2000,
          "stores": {
            "bank": {
              "gets": 1000,
              "updates": 20000
            }
          }
        }
      ],
      "concurrent_readers": 32
    }
  ]
}
