{
  "configs": [
    {
      "name": "iavlx2-mem",
      "runner": "bench-iavlx2",
      "options": {
        "write_wal": false,
      }
    },
    {
      "name": "iavlx2-wal",
      "runner": "bench-iavlx2",
      "options": {
        "write_wal": true,
        "fsync_wal": false
      }
    },
    {
      "name": "iavlx2-wal-fsync",
      "runner": "bench-iavlx2",
      "options": {
        "write_wal": true,
        "fsync_wal": true
      }
    }
  ],
  "simulations": [
    {
      "name": "1m",
      "stores": [ { "name": "bank", "key_len_mean": 56, "key_len_stddev": 3, "value_len_mean": 16, "value_len_stddev": 2 } ],
      "phases": [
        { "versions": 100, "stores": { "bank": { "inserts": 10000 } } },
        { "versions": 2000, "stores": { "bank": { "updates": 10000 } } }
      ]
    },
    {
      "name": "1mx2",
      "stores": [
        { "name": "bank", "key_len_mean": 56, "key_len_stddev": 3, "value_len_mean": 16, "value_len_stddev": 2 },
        { "name": "bank2", "key_len_mean": 56, "key_len_stddev": 3, "value_len_mean": 16, "value_len_stddev": 2 }
      ],
      "phases": [
        { "versions": 100, "stores": { "bank": { "inserts": 10000 }, "bank2": {"inserts": 10000} } },
        { "versions": 2000, "stores": { "bank": { "updates": 10000 }, "bank2": {"updates":  10000} } }
      ]
    },
    {
      "name": "1mx5",
      "stores": [
        { "name": "bank", "key_len_mean": 56, "key_len_stddev": 3, "value_len_mean": 16, "value_len_stddev": 2 },
        { "name": "bank2", "key_len_mean": 56, "key_len_stddev": 3, "value_len_mean": 16, "value_len_stddev": 2 },
        { "name": "bank3", "key_len_mean": 56, "key_len_stddev": 3, "value_len_mean": 16, "value_len_stddev": 2 },
        { "name": "bank4", "key_len_mean": 56, "key_len_stddev": 3, "value_len_mean": 16, "value_len_stddev": 2 },
        { "name": "bank5", "key_len_mean": 56, "key_len_stddev": 3, "value_len_mean": 16, "value_len_stddev": 2 }
      ],
      "phases": [
        { "versions": 100, "stores": { "bank": { "inserts": 10000 }, "bank2": {"inserts": 10000} }, "bank3": {"inserts": 10000}, "bank4": {"inserts": 10000}, "bank5": {"inserts": 10000} },
        { "versions": 2000, "stores": { "bank": { "updates": 10000 }, "bank2": {"updates":  10000} }, "bank3": {"updates": 10000}, "bank4": {"updates": 10000}, "bank5": {"updates": 10000} }
      ]
    },
    {
      "name": "1mx10",
      "stores": [
        { "name": "bank", "key_len_mean": 56, "key_len_stddev": 3, "value_len_mean": 16, "value_len_stddev": 2 },
        { "name": "bank2", "key_len_mean": 56, "key_len_stddev": 3, "value_len_mean": 16, "value_len_stddev": 2 },
        { "name": "bank3", "key_len_mean": 56, "key_len_stddev": 3, "value_len_mean": 16, "value_len_stddev": 2 },
        { "name": "bank4", "key_len_mean": 56, "key_len_stddev": 3, "value_len_mean": 16, "value_len_stddev": 2 },
        { "name": "bank5", "key_len_mean": 56, "key_len_stddev": 3, "value_len_mean": 16, "value_len_stddev": 2 }
        { "name": "bank6", "key_len_mean": 56, "key_len_stddev": 3, "value_len_mean": 16, "value_len_stddev": 2 },
        { "name": "bank7", "key_len_mean": 56, "key_len_stddev": 3, "value_len_mean": 16, "value_len_stddev": 2 },
        { "name": "bank8", "key_len_mean": 56, "key_len_stddev": 3, "value_len_mean": 16, "value_len_stddev": 2 },
        { "name": "bank9", "key_len_mean": 56, "key_len_stddev": 3, "value_len_mean": 16, "value_len_stddev": 2 },
        { "name": "bank10", "key_len_mean": 56, "key_len_stddev": 3, "value_len_mean": 16, "value_len_stddev": 2 }
      ],
      "phases": [
        { "versions": 100, "stores": { "bank": { "inserts": 10000 }, "bank2": {"inserts": 10000} }, "bank3": {"inserts": 10000}, "bank4": {"inserts": 10000}, "bank5": {"inserts": 10000}, "bank6": {"inserts": 10000}, "bank7": {"inserts": 10000}, "bank8": {"inserts": 10000}, "bank9": {"inserts": 10000}, "bank10": {"inserts": 10000} },
        { "versions": 2000, "stores": { "bank": { "updates": 10000 }, "bank2": {"updates":  10000} }, "bank3": {"updates": 10000}, "bank4": {"updates": 10000}, "bank5": {"updates": 10000}, "bank6": {"updates": 10000}, "bank7": {"updates": 10000}, "bank8": {"updates": 10000}, "bank9": {"updates": 10000}, "bank10": {"updates": 10000} }
      ]
    },
