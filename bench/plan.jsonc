{
  "configs": [
    {
      "name": "iavlx2-sync",
      "runner": "bench-iavlx2",
      "options": {
        "fsync": true
      }
    }
  ],
  "simulations": [
    {
      "name": "wal-1m",
      "stores": [
        {
          "name": "bank",
          "key_len_mean": 56,
          "key_len_stddev": 3,
          "value_len_mean": 16,
          "value_len_stddev": 2
        }
      ],
      "phases": [
        {
          "versions": 100,
          "stores": {
            "bank": {
              "inserts": 10000
            }
          }
        },
        {
          "versions": 2000,
          "stores": {
            "bank": {
              "updates": 10000
            }
          }
        }
      ]
    },
